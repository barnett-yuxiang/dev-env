# Claude Code 使用 New API
export ANTHROPIC_BASE_URL="https://new-api.iohubonline.club"
export ANTHROPIC_AUTH_TOKEN="<YOUR_ANTHROPIC_AUTH_TOKEN>"

export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1

# Claude Code 可用模型列表
# -thinking 后缀是 new-api 自定义的 alias，代表默认开启思考模式，不是 Anthropic 官方 model ID
# [1m] 后缀是 Claude Code 自己的约定：请求 1M context（加 beta header），不加默认 200K
# export ANTHROPIC_MODEL="claude-fable-5-1"
# export ANTHROPIC_MODEL="claude-fable-5-thinking"
# export ANTHROPIC_MODEL="claude-fable-5"
export ANTHROPIC_MODEL="claude-opus-5[1m]"
