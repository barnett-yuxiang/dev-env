# Claude Opus 4.8 key info
# Model ID      : claude-opus-4-8-thinking
# Context/Output: 1M / 128K (stream required when output > 16K)
# Pricing       : $5 input, $25 output per 1M tokens
# Thinking      : adaptive only; no budget_tokens, no sampling params; effort low~max (default high)
# Access        : third-party proxy new-api.iohubonline.club -> Bedrock backend; token limited to Opus

# Claude Code 使用 New API
export ANTHROPIC_BASE_URL="https://new-api.iohubonline.club"
export ANTHROPIC_AUTH_TOKEN="<YOUR_ANTHROPIC_AUTH_TOKEN>"

# Claude Code 默认模型
export ANTHROPIC_MODEL="claude-opus-4-8-thinking"

# Claude Code 推理强度
export CLAUDE_CODE_EFFORT_LEVEL="xhigh"
