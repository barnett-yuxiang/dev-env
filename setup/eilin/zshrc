# eilin - native zsh config v0.1.0

# Prerequisites:
#   brew install curl wget git
#   brew install bat eza ripgrep jq fzf
#   brew install tmux
#   brew install gh
#   brew install zsh-autosuggestions zsh-syntax-highlighting

# Install pyenv:
#   brew install pyenv
# Install Python build dependencies:
#   https://github.com/pyenv/pyenv/wiki#suggested-build-environment
#   brew install openssl@3 readline sqlite3 xz tcl-tk@8 libb2 zstd zlib pkgconfig

# Load order: PATH -> language envs -> compinit -> compinit-dependent -> private -> plugins
# Homebrew PATH is injected by ~/.zprofile (brew shellenv)

# Keep PATH/FPATH free of duplicates when this file is re-sourced or nested.
# Both the array and the scalar must be marked: scalar assignment bypasses the array's -U.
typeset -U path PATH fpath FPATH

# HomeBrew Config {{

# Keg-only formulae: flags accumulate into LDFLAGS / CPPFLAGS / PKG_CONFIG_PATH
# so that compilers (e.g. pyenv building CPython) can find them.
# Cleared first because these are exported and would otherwise grow on every nested shell.
unset LDFLAGS CPPFLAGS PKG_CONFIG_PATH

# curl
export PATH="/opt/homebrew/opt/curl/bin:$PATH"
export LDFLAGS="-L/opt/homebrew/opt/curl/lib${LDFLAGS:+ $LDFLAGS}"
export CPPFLAGS="-I/opt/homebrew/opt/curl/include${CPPFLAGS:+ $CPPFLAGS}"
export PKG_CONFIG_PATH="/opt/homebrew/opt/curl/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

# sqlite
export PATH="/opt/homebrew/opt/sqlite/bin:$PATH"
export LDFLAGS="-L/opt/homebrew/opt/sqlite/lib${LDFLAGS:+ $LDFLAGS}"
export CPPFLAGS="-I/opt/homebrew/opt/sqlite/include${CPPFLAGS:+ $CPPFLAGS}"
export PKG_CONFIG_PATH="/opt/homebrew/opt/sqlite/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

# zlib
export LDFLAGS="-L/opt/homebrew/opt/zlib/lib${LDFLAGS:+ $LDFLAGS}"
export CPPFLAGS="-I/opt/homebrew/opt/zlib/include${CPPFLAGS:+ $CPPFLAGS}"
export PKG_CONFIG_PATH="/opt/homebrew/opt/zlib/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

# tcl-tk@8 - required for CPython's tkinter; CPython 3.11+ locates it via pkg-config
export LDFLAGS="-L/opt/homebrew/opt/tcl-tk@8/lib${LDFLAGS:+ $LDFLAGS}"
export CPPFLAGS="-I/opt/homebrew/opt/tcl-tk@8/include${CPPFLAGS:+ $CPPFLAGS}"
export PKG_CONFIG_PATH="/opt/homebrew/opt/tcl-tk@8/lib/pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"

# If you need the sqlite3_analyzer binary, it's available in the `sqlite-analyzer` formula.

# }} HomeBrew Config

# Config Go env {{

# go version go1.25.12 darwin/arm64
# https://go.dev/doc/install
export GOPATH="$HOME/go"
export PATH="$GOPATH/bin:$PATH"

# }} Config Go env

# Config Python env {{

# https://github.com/pyenv/pyenv
# pyenv itself comes from Homebrew; PYENV_ROOT only points at the versions/shims tree
export PYENV_ROOT="$HOME/.pyenv"
eval "$(pyenv init - zsh)"

# }} Config Python env

# Config Node env {{

# install: https://github.com/nvm-sh/nvm (install script clones into ~/.nvm)
# NOTE: nvm's tab completion lives in the Completion section below (needs bashcompinit)
export NVM_DIR="$HOME/.nvm"
source "$NVM_DIR/nvm.sh"

# }} Config Node env

# Config Top PATH {{

# include: commonly used shell scripts and command-line tools
# https://github.com/barnett-yuxiang/dev-garage
export PATH="$HOME/repo_projects/github/toolkit/dev-garage:$PATH"

# include: user-installed command-line tools
export PATH="$HOME/.local/bin:$PATH"

# include: personal scripts and binaries
# include: yt-dlp_macos
# include: repo // from aosp
export PATH="$HOME/bin:$PATH"

# }} Config Top PATH

# History {{

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

setopt SHARE_HISTORY
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_REDUCE_BLANKS

# }} History

# Completion {{

zmodload -i zsh/complist
autoload -Uz compinit
compinit

zstyle ':completion:*' menu select

# nvm completion (NVM_DIR comes from the Config Node env section above).
# Kept here because it is bash-style: bashcompinit must run after compinit.
autoload -U +X bashcompinit && bashcompinit
source "$NVM_DIR/bash_completion"

# }} Completion

# fzf {{

# Ctrl-R history / Ctrl-T files / Option-C cd
source <(fzf --zsh)

# }} fzf

# Key Bindings {{

# Make Up/Down filter history by the text already typed, instead of walking it chronologically.
autoload -Uz up-line-or-beginning-search down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search
bindkey '^[[A' up-line-or-beginning-search
bindkey '^[[B' down-line-or-beginning-search

# }} Key Bindings

# Prompt {{

# Branch name and dirty markers; vcs_info ships with zsh, no plugin needed.
autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' enable git
# check-for-changes is what enables %u/%c, and also what makes it slow in huge repos.
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:git:*' unstagedstr '*'
zstyle ':vcs_info:git:*' stagedstr '+'
zstyle ':vcs_info:git:*' formats       ' (%b%u%c)'
zstyle ':vcs_info:git:*' actionformats ' (%b|%a%u%c)'

add-zsh-hook precmd vcs_info
setopt PROMPT_SUBST
PROMPT='%n@%m %1~%F{yellow}${vcs_info_msg_0_}%f %# '

# }} Prompt

# Useful Aliases {{

# Standard macOS directory listing

export CLICOLOR=1
export LSCOLORS=ExGxFxdxCxegedabagacad

alias ll='ls -alF'  # Long format, hidden files and file type indicators
alias la='ls -A'    # All entries except "." and ".."
alias l='ls -CF'    # Column format with file type indicators

# Enhanced directory listing with eza
alias ell='eza -lah --git --group-directories-first'
alias ela='eza -a --group-directories-first'
alias el='eza --group-directories-first'

# Update global gitconfig
alias update-gitconfig-user='git config --global user.name "$GIT_USER_NAME" && git config --global user.email "$GIT_USER_EMAIL"'
alias update-gitconfig-editor-vim='git config --global core.editor "vim"'
alias update-gitconfig-default-branch='git config --global init.defaultBranch "main"'
alias update-gitconfig-color-ui='git config --global color.ui "auto"'
alias update-gitconfig-autocrlf-input='git config --global core.autocrlf "input"'
alias update-gitconfig-quotepath-false='git config --global core.quotepath "false"'

# }} Useful Aliases

# Useful Function {{

update-gitconfig-all() {
    update-gitconfig-user
    update-gitconfig-editor-vim
    update-gitconfig-default-branch
    update-gitconfig-color-ui
    update-gitconfig-autocrlf-input
    update-gitconfig-quotepath-false
}

ggitcfg_check() {
    git --no-pager config --global -l
}

# 检查当前 PATH 是否重复
# 查看每个 PATH entry:
#   print -l ${(s.:.)PATH}
#
# 检查重复项:
#   print -l ${(s.:.)PATH} | sort | uniq -d
#
# No output means that PATH contains no duplicated entries.

# }} Useful Function

# Private environment variables
source "$HOME/.zshrc.private"

# Plugins {{

source /opt/homebrew/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

# }} Plugins

# EOF
