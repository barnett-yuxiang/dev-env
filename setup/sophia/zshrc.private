# Claude Code 使用 New API
export ANTHROPIC_BASE_URL="https://new-api.iohubonline.club"
export ANTHROPIC_AUTH_TOKEN="<YOUR_ANTHROPIC_AUTH_TOKEN>"

# Claude Code 默认模型
# -thinking 后缀是 new-api proxy 自定义的 alias，不是 Anthropic 官方 model ID
# （官方只有 claude-opus-5，thinking 由 request 参数控制）；换回官方 endpoint 时要去掉后缀
# export ANTHROPIC_MODEL="claude-fable-5"
# export ANTHROPIC_MODEL="claude-fable-5-thinking"
export ANTHROPIC_MODEL="claude-opus-5-thinking"
# export ANTHROPIC_MODEL="claude-opus-4-8-thinking"
# export ANTHROPIC_MODEL="claude-opus-4-6-thinking"
# export ANTHROPIC_MODEL="claude-sonnet-5-thinking"
