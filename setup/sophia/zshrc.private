export GIT_USER_EMAIL="<YOUR_GIT_USER_EMAIL>"

# iohub metabase
export IOHUB_METABASE_URL="<YOUR_IOHUB_METABASE_BASE_URL>"
export IOHUB_METABASE_USERNAME="<YOUR_IOHUB_METABASE_USERNAME>"
