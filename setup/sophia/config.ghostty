# sophia · ghostty config
#
# Location: ~/.config/ghostty/config.ghostty

# ---------- Font ----------

# JetBrainsMono Nerd Font, FiraCode Nerd Font, FiraMono Nerd Font
font-family = MesloLGS Nerd Font
font-size = 13

# 稍微加粗字体笔画，仅 macOS
font-thicken = true

# ---------- Appearance ----------

# 固定暗色主题；tabs 标题栏会根据终端背景自动使用暗色外观
theme = Catppuccin Mocha

# 关闭光标闪烁
cursor-style-blink = false

# 将 Tab bar 整合进标题栏
macos-titlebar-style = tabs

# ---------- Window ----------

# 初始终端网格：列 × 行
window-width = 168
window-height = 48

# 窗口内边距，单位为 point
window-padding-x = 8
window-padding-y = 6

# 均衡 Cell 无法整除产生的额外边缘空间
window-padding-balance = true

# 不恢复上一次的窗口、Tab 和 Split 状态
window-save-state = never

# ---------- Resize ----------

# 按终端 Cell 的整数倍调整窗口大小
window-step-resize = true

# 首次创建窗口时不显示，后续 resize 时显示列数 × 行数
resize-overlay = after-first

# ---------- Misc ----------

# 每个 Terminal surface 最多约 100 MB scrollback
scrollback-limit = 100000000

# 左 Option 作为 Alt，右 Option 保留 macOS 原始行为
macos-option-as-alt = left

# 禁止终端程序通过 Escape Sequence 发送系统通知
desktop-notifications = false
